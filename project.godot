; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Corral"
config/description="An endless enclosure puzzle."
config/version="1.0.0"
run/main_scene="res://game/scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.996, 0.957, 0.914, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/splash.png"
config/icon="res://assets/icon.svg"

[autoload]

Save="*res://game/autoload/save.gd"
Catalog="*res://game/autoload/catalog.gd"
Profile="*res://game/autoload/profile.gd"
Audio="*res://game/autoload/audio.gd"
Haptics="*res://game/autoload/haptics.gd"
Store="*res://game/autoload/store.gd"
AdManager="*res://game/ads/ad_manager.gd"
ShareService="*res://game/autoload/share_service.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGooglePlayBilling/plugin.cfg", "res://addons/admob/plugin.cfg", "res://addons/corral_share/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.996, 0.957, 0.914, 1)
